{
  "env": {
    "IS_SANDBOX": "true"
  },
  "permissions": {
    "allow": [
      "Bash(bash ~/.dotfiles/scripts/*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Reminder: before running ad-hoc commands, check the available-skills list for a trigger-phrase match on this prompt. If one matches, invoke that skill via the Skill tool instead of manual tool calls.\"}}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "it2attention once"
          },
          {
            "type": "command",
            "command": "rm -f /tmp/claude_tmux_status"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "stable",
  "tui": "default",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "vimInsertModeRemaps": {
    "jk": "<Esc>"
  },
  "model": "opus"
}

#!/usr/bin/env bash
# Lint staged shell scripts

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|zsh|md|lua|json|plist)$')

if [ -z "$files" ]; then
  exit 0
fi

failed=0
while IFS= read -r file; do
  case "$file" in
    *.zsh)
      echo "zsh -n: $file"
      if ! zsh -n "$file"; then
        failed=1
      fi
      ;;
    *.sh)
      if command -v shellcheck &>/dev/null; then
        echo "shellcheck: $file"
        if ! shellcheck -x "$file"; then
          failed=1
        fi
      else
        echo "bash -n: $file"
        if ! bash -n "$file"; then
          failed=1
        fi
      fi
      ;;
    *.md)
      if command -v markdownlint-cli2 &>/dev/null; then
        echo "markdownlint-cli2: $file"
        if ! markdownlint-cli2 "$file"; then
          failed=1
        fi
      fi
      ;;
    *.lua)
      if command -v stylua &>/dev/null; then
        echo "stylua --check: $file"
        if ! stylua --check "$file"; then
          failed=1
        fi
      fi
      ;;
    *.json)
      echo "jq empty: $file"
      if ! jq empty "$file"; then
        failed=1
      fi
      ;;
    *.plist)
      echo "plutil -lint: $file"
      if ! plutil -lint "$file"; then
        failed=1
      fi
      ;;
  esac
done <<< "$files"

if [ "$failed" -ne 0 ]; then
  echo "Lint failed. Fix the issues or use 'git commit --no-verify' to skip." >&2
  exit 1
fi
